# Copie para .env.local e preencha. Nenhum destes valores é secreto de
# produção — são placeholders para você rodar o app na sua própria máquina.

# Postgres do Neon (ou qualquer Postgres compatível). O app lê via
# @neondatabase/serverless — ver `lib/db/client.ts`.
DATABASE_URL=postgresql://usuario:senha@host/banco?sslmode=require

# Auth (Better Auth) das áreas logadas. Gere um valor aleatório qualquer
# (ex.: `openssl rand -base64 32`) — só precisa ser estável entre reinícios
# do servidor local.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# E-mail transacional (Resend) — usado só pelas rotas de convite/recuperação
# de senha das áreas logadas. Deixe em branco para rodar sem isso; o app não
# quebra, só essas rotas específicas não enviam e-mail de verdade.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Autoriza as rotas /api/admin/*. Só relevante em produção (é um secret do
# Worker, não do dev local); deixe em branco aqui.
ADMIN_TOKEN=
