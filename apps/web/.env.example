# Copie para .env.local e preencha. Nenhum destes valores é secreto de
# produção — são placeholders para você rodar o app na sua própria máquina.

# Postgres principal — Guara Cloud, Supabase, Neon ou qualquer Postgres.
# O driver é escolhido automaticamente pelo hostname (ver lib/db/client.ts):
#   - localhost/127.0.0.1 → pg (TCP, build local)
#   - *.neon.tech → @neondatabase/serverless (HTTP)
#   - qualquer outro → pg (TCP, ex: Guara Cloud)
DATABASE_URL=postgresql://usuario:senha@host/banco?sslmode=require

# Neon como FALLBACK (opcional). Se o primary falhar e esta variável
# estiver configurada, o app tenta a Neon automaticamente. Útil quando o
# Guara Cloud (ou outro Postgres remoto) está fora.
DATABASE_URL_NEON=

# Auth (Better Auth) das áreas logadas. Gere um valor aleatório qualquer
# (ex.: `openssl rand -base64 32`) — só precisa ser estável entre reinícios
# do servidor local.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# E-mail transacional (Resend) — usado só pelas rotas de convite/recuperação
# de senha das áreas logadas. Deixe em branco para rodar sem isso; o app não
# quebra, só essas rotas específicas não enviam e-mail de verdade.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Autoriza as rotas /api/admin/*. Só relevante em produção (é um secret do
# Worker, não do dev local); deixe em branco aqui.
ADMIN_TOKEN=

# R2 — espelho de documentos-fonte (normas, atas, etc.).
# Crie o token em: Dashboard > R2 > Manage R2 API Tokens > Create API Token.
# Endpoint: https://<account_id>.r2.cloudflarestorage.com
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=controlepopular-fontes

# IA do assistente — degrau 3 (so quando os degraus 0-2 devolvem vazio).
# Chaves dos tres provedores compativeis com OpenAI. O provedor ATIVO e
# escolhido no painel de edicao (/painel) e os demais viram fallback
# automatico na ordem DeepSeek -> Maritaca -> Ling. Cada provedor usa a
# variante flash/mais barata (deepseek-v4-flash, sabiazinho-4, Ling-2.6-flash).
# Deixar todas em branco faz o degrau 3 cair para o Ollama local (L4).
AI_API_KEY_DEEPSEEK=
AI_API_KEY_MARITACA=
AI_API_KEY_LING=

# Chave GENERICA do ambiente (caso do Guara Cloud): usada como fallback
# quando nenhuma variante acima existe. O provedor e deduzido de AI_BASE_URL
# (padrao Maritaca). So o NOME da env vive no codigo; o valor fica no painel.
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=

# Embeddings remotos (SiliconFlow BAAI/bge-m3 — gratis, 1024 dims) para o
# RAG do Seu Nono quando o Ollama local nao existe (ex.: container Guara,
# teto de 256 MB de RAM). Sem chave, o pipeline usa Ollama local (dev).
EMBED_API_KEY=
EMBED_BASE_URL=https://api.siliconflow.cn/v1
EMBED_MODEL=BAAI/bge-m3

