# Modelo para scripts/.env (gitignored — o padrão `.env` do .gitignore raiz
# já cobre qualquer profundidade). Copie para scripts/.env e preencha.
#
# GATILHO_TOKEN: qualquer valor aleatório, estável entre reinícios — mesmo
# espírito do PAINEL_TOKEN (docs/PAINEL-EDICAO-COMO-USAR.md): próprio deste
# canal, nunca reusado de outro, porque cada token tem um raio de vazamento
# diferente. Gere com: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
GATILHO_TOKEN=

# Os mesmos dois valores já usados em .github/workflows/canario-limites.yml
# (secrets do GitHub) — copie de lá, ou do @BotFather / do chat_id que você
# já usa para os alertas do canário.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Quem pode dar DEPLOY e rodar comando de desenvolvimento (/deploy,
# /sincronizar, /reiniciar, /rodar, /webhook). Lista separada por vírgula,
# com os MESMOS chat_id do Telegram (não é @usuário).
# Vazio = só o TELEGRAM_CHAT_ID de cima pode publicar (padrão, fail-closed).
TELEGRAM_ADMINS=

# Obrigatório para o bot de trabalho responder a comando. Sem isto o
# long-poll NÃO sobe (fica desligado para não brigar com o Hermes, conflito
# 409 do Telegram). Preencha com "true" e reinicie o gatilho.
GATILHO_TELEGRAM_POLL=true

# Opcional — padrão 3029 se ausente (3028 já é do painel de edição).
GATILHO_PORTA=3029
