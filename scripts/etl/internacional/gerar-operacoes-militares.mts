async function executar() {
  console.log("=== INICIANDO ETL DE OPERAÇÕES MILITARES, CONTRATOS E PMCS ===");
  console.log(`Total de eventos brutos mapeados: ${OPERACOES_MILITARES.length}`);

  if (!fs.existsSync(DIR_OUT)) {
    fs.mkdirSync(DIR_OUT, { recursive: true });
  }

  // Sanitização e normalização de chaves uniformes para o esqueleto do compactar
  const operacoesSanitizadas = OPERACOES_MILITARES.map((op) => {
    return {
      id: op.id,
      codinome: op.codinome,
      titulo: sanitizarDadoPessoalInternacional(op.titulo),
      resumo: sanitizarDadoPessoalInternacional(op.resumo),
      tipoOperacao: op.tipoOperacao,
      anoInicio: op.anoInicio,
      anoFim: op.anoFim ?? null,
      duracaoEstimada: op.duracaoEstimada,
      paisesPatrocinadores: op.paisesPatrocinadores,
      orgaosForcasEnvolvidas: op.orgaosForcasEnvolvidas,
      pmcsEnvolvidas: op.pmcsEnvolvidas ?? [],
      principaisContratadasDefesa: op.principaisContratadasDefesa ?? [],
      paisTeatro: op.paisTeatro,
      continenteTeatro: op.continenteTeatro,
      localidadeFoco: op.localidadeFoco,
      latitude: op.latitude,
      longitude: op.longitude,
      baixasEstimadas: op.baixasEstimadas ?? "",
      custoFinanceiroEstimado: op.custoFinanceiroEstimado ?? "",
      desfechoSoberania: sanitizarDadoPessoalInternacional(op.desfechoSoberania),
      conexaoBrasilOuAmericaLatina: op.conexaoBrasilOuAmericaLatina
        ? sanitizarDadoPessoalInternacional(op.conexaoBrasilOuAmericaLatina)
        : "",
      fonteOficialNome: op.fonteOficialNome,
      urlFonteOficial: op.urlFonteOficial,
      urlDocumentoOriginalPdf: op.urlDocumentoOriginalPdf ?? "",
      identificadorOficialDoc: op.identificadorOficialDoc ?? "",
      assuntos: op.assuntos,
    };
  });

  // Compactação estática com codec de strings internadas
  const payloadCompactado = compactar(operacoesSanitizadas);
  const jsonCompactado = JSON.stringify(payloadCompactado);

  const caminhoSaida = path.join(DIR_OUT, "operacoes-militares.compact.json");
  fs.writeFileSync(caminhoSaida, jsonCompactado, "utf-8");

  const tamanhoKb = (Buffer.byteLength(jsonCompactado, "utf-8") / 1024).toFixed(1);
  console.log(`✅ Arquivo gerado com sucesso: ${caminhoSaida} (${tamanhoKb} KB)`);
  console.log(`✅ Total de operações militarmente geolocalizadas: ${operacoesSanitizadas.length}`);
}

executar().catch((erro) => {
  console.error("❌ Erro fatal no ETL de operações militares:", erro);
  process.exit(1);
});
