/**
 * Converte o tipo interno em rótulo em português acessível.
 */
function rotuloTipo(tipo: TipoBarragem): string {
  switch (tipo) {
    case "rejeitos_mineracao":
      return "Rejeitos de Mineração";
    case "hidreletrica":
      return "Hidrelétrica & Energia";
    case "abastecimento_multiuso":
      return "Abastecimento & Multiuso";
    case "controle_cheias":
      return "Controle de Cheias";
    default:
      return tipo;
  }
}

/**
 * Converte o status operacional em rótulo em português.
 */
function rotuloStatus(status: StatusOperacional): string {
  switch (status) {
    case "em_operacao":
      return "Em Operação";
    case "desativada_descaracterizacao":
      return "Descaracterização / Desativada";
    case "rompida_historico":
      return "Rompida (Histórico)";
    case "em_construcao":
      return "Em Construção";
    default:
      return status;
  }
}

/**
 * Executa o ETL gerando o acervo compacto e a camada GeoJSON.
 */
export async function executar(): Promise<void> {
  console.log(`Iniciando ETL de Barragens Mundiais (${BARRAGENS_MUNDIAIS_BRUTAS.length} estruturas)...`);

  // 1. Garantir diretórios de saída
  if (!fs.existsSync(DIR_DATA_OUT)) {
    fs.mkdirSync(DIR_DATA_OUT, { recursive: true });
  }
  if (!fs.existsSync(DIR_GEOJSON_OUT)) {
    fs.mkdirSync(DIR_GEOJSON_OUT, { recursive: true });
  }

  // 2. Compactação do JSON de dados
  const tabelaCompacta = compactar(BARRAGENS_MUNDIAIS_BRUTAS as unknown as Record<string, unknown>[]);
  const caminhoCompactJson = path.join(DIR_DATA_OUT, "barragens-mundiais.compact.json");
  fs.writeFileSync(caminhoCompactJson, JSON.stringify(tabelaCompacta), "utf-8");

  const tamanhoKb = (Buffer.byteLength(JSON.stringify(tabelaCompacta), "utf-8") / 1024).toFixed(1);
  console.log(`✅ Arquivo compacto salvo: ${caminhoCompactJson} (${tamanhoKb} KB)`);

  // 3. Montagem e gravação da camada GeoJSON WGS84 para o Globo 3D
  const distribuicaoTipos: Record<string, number> = {};
  for (const b of BARRAGENS_MUNDIAIS_BRUTAS) {
    distribuicaoTipos[b.tipoBarragem] = (distribuicaoTipos[b.tipoBarragem] || 0) + 1;
  }

  const features = BARRAGENS_MUNDIAIS_BRUTAS.map((barragem) => ({
    type: "Feature",
    id: barragem.id,
    geometry: {
      type: "Point",
      coordinates: [barragem.longitude, barragem.latitude], // WGS84 [lon, lat]
    },
    properties: {
      id: barragem.id,
      nome: barragem.nome,
      tipo: barragem.tipoBarragem,
      tipoRotulo: rotuloTipo(barragem.tipoBarragem),
      tipoEstrutura: barragem.tipoEstrutura,
      pais: barragem.pais,
      continente: barragem.continente,
      rioOuBacia: barragem.rioOuBacia,
      alturaMetros: barragem.alturaMetros,
      volumeCapacidadeMm3: barragem.volumeCapacidadeMm3,
      operador: barragem.operador,
      risco: barragem.classificacaoRiscoOuHazard,
      status: barragem.statusOperacional,
      statusRotulo: rotuloStatus(barragem.statusOperacional),
      ano: barragem.anoConclusao,
      resumo: barragem.resumoCivico,
      orgaoRegulador: barragem.orgaoReguladorOuBase,
      linkOficial: barragem.linkFonteOficial,
      tags: barragem.tags,
    },
  }));

  const geojson = {
    type: "FeatureCollection",
    metadata: {
      fonte: "Controle Popular — Observatório Global de Grandes Barragens (ICOLD, Global Tailings Portal, USACE NID, ANM/SIGBM)",
      dataAtualizacao: "2026-10-01",
      totalFeicoes: features.length,
      distribuicaoTipos,
      aviso: "Coordenadas georreferenciadas oficiais WGS84 compiladas a partir de registros estatais e cadastros públicos.",
    },
    features,
  };

  const caminhoGeojson = path.join(DIR_GEOJSON_OUT, "barragens-mundiais-destaque.geojson");
  fs.writeFileSync(caminhoGeojson, JSON.stringify(geojson, null, 2), "utf-8");

  const tamanhoGeojsonKb = (Buffer.byteLength(JSON.stringify(geojson), "utf-8") / 1024).toFixed(1);
  console.log(`✅ Camada GeoJSON salva: ${caminhoGeojson} (${tamanhoGeojsonKb} KB)`);
  console.log(`✅ Total de grandes barragens mundiais geradas: ${features.length}`);
}

// Execução direta via CLI
if (process.argv[1] && process.argv[1].endsWith("gerar-barragens-mundiais.mts")) {
  executar().catch((erro) => {
    console.error("❌ Erro fatal ao gerar acervo de barragens mundiais:", erro);
    process.exit(1);
  });
}
