/**
 * @file scripts/etl/ambiente/gerar-barragens-mundiais.mts
 * @description ETL gerador do acervo de Grandes Barragens Mundiais (água, energia, mineração).
 *
 * Papel no portal:
 * Gera o acervo compacto em apps/web/data/ambiente/barragens-mundiais.compact.json
 * e a camada GeoJSON apps/web/public/terras/globo/dados/camadas/barragens-mundiais-destaque.geojson
 * para visualização geoespacial no Globo 3D Terras e no portal cívico.
 *
 * Fontes oficiais consultadas:
 * - ICOLD (International Commission on Large Dams — World Register of Dams)
 * - Global Tailings Portal (GRID-Arendal / UNEP / Church of England Pensions Board)
 * - USACE NID (United States Army Corps of Engineers — National Inventory of Dams)
 * - ANM / SIGBM (Agência Nacional de Mineração — Sistema Integrado de Gestão de Segurança de Barragens de Mineração)
 * - ANA (Agência Nacional de Águas e Saneamento Básico — Relatório de Segurança de Barragens - RSB)
 * - MITECO (Ministério para a Transição Ecológica da Espanha)
 * - BC Ministry of Energy, Mines and Low Carbon Innovation (Canadá)
 *
 * Conformidade e segurança:
 * - Zero dados pessoais / sem CPFs (AGENTS.md §5.2).
 * - Coordenadas precisas em datum WGS84 [longitude, latitude].
 * - Padrão das Seis Qualidades do Controle Popular (AGENTS.md §8).
 * - Compactação de tabela versionada por esqueleto + rótulos internados (compactar.ts).
 */

import fs from "node:fs";
import path from "node:path";
import { fileURLToPath } from "node:url";
import { compactar } from "../../../apps/web/lib/estatico/compactar.js";

const RAIZ = path.resolve(path.dirname(fileURLToPath(import.meta.url)), "../../..");
const DIR_DATA_OUT = path.join(RAIZ, "apps", "web", "data", "ambiente");
const DIR_GEOJSON_OUT = path.join(
  RAIZ,
  "apps",
  "web",
  "public",
  "terras",
  "globo",
  "dados",
  "camadas"
);

export type TipoBarragem =
  | "rejeitos_mineracao"
  | "hidreletrica"
  | "abastecimento_multiuso"
  | "controle_cheias";

export type StatusOperacional =
  | "em_operacao"
  | "desativada_descaracterizacao"
  | "rompida_historico"
  | "em_construcao";

export interface BarragemMundialBruta {
  id: string;
  nome: string;
  tipoBarragem: TipoBarragem;
  tipoEstrutura: string;
  pais: string;
  continente:
    | "América do Sul"
    | "América do Norte"
    | "Europa"
    | "Ásia"
    | "África"
    | "Oceania";
  rioOuBacia: string;
  alturaMetros: number;
  volumeCapacidadeMm3: number;
  operador: string;
  classificacaoRiscoOuHazard: string;
  statusOperacional: StatusOperacional;
  anoConclusao: number;
  latitude: number;
  longitude: number;
  resumoCivico: string;
  orgaoReguladorOuBase: string;
  linkFonteOficial: string;
  tags: string[];
}

