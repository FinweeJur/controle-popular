/**
 * Executa o pipeline de geração, validação e compactação dos conflitos socioambientais globais.
 */
export function executarEtlConflitosGlobais(): void {
  console.log("🌍 Iniciando ETL de Conflitos Socioambientais Globais...");

  if (!fs.existsSync(DATA_DIR)) {
    fs.mkdirSync(DATA_DIR, { recursive: true });
  }

  // Validação de integridade e completude
  console.log(`📊 Mapeados ${CONFLITOS_SOCIOAMBIENTAIS_GLOBAIS.length} conflitos socioambientais globais.`);

  const idsVistos = new Set<string>();
  for (const c of CONFLITOS_SOCIOAMBIENTAIS_GLOBAIS) {
    if (idsVistos.has(c.id)) {
      throw new Error(`ID duplicado detectado: ${c.id}`);
    }
    idsVistos.add(c.id);

    if (!c.nome || !c.pais || !c.continente || !c.commodities || !c.comunidades || !c.empresas || !c.tipoDano || !c.status) {
      throw new Error(`Registro incompleto para: ${c.id}`);
    }

    if (typeof c.latitude !== "number" || typeof c.longitude !== "number" || isNaN(c.latitude) || isNaN(c.longitude)) {
      throw new Error(`Coordenadas inválidas para: ${c.id}`);
    }

    if (!c.linkOficial.startsWith("https://")) {
      throw new Error(`Link oficial deve iniciar com https:// para: ${c.id} (${c.linkOficial})`);
    }
  }

  // Compactar dados usando o padrão do repositório (compactar.ts)
  const compactado = compactar(CONFLITOS_SOCIOAMBIENTAIS_GLOBAIS as unknown as Record<string, unknown>[]);
  const caminhoDestino = path.join(DATA_DIR, "conflitos-socioambientais.compact.json");

  fs.writeFileSync(caminhoDestino, JSON.stringify(compactado), "utf-8");
  console.log(`✓ Arquivo compactado gravado com sucesso em: ${caminhoDestino}`);
  console.log(`✓ Total de conflitos: ${CONFLITOS_SOCIOAMBIENTAIS_GLOBAIS.length}`);
}

if (process.argv[1] && process.argv[1].endsWith("gerar-conflitos-globais.mts")) {
  executarEtlConflitosGlobais();
}
