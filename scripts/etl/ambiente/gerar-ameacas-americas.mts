const __filename = fileURLToPath(import.meta.url);
const __dirname = path.dirname(__filename);
const RAIZ = path.resolve(__dirname, "../../..");
const DIR_DATA = path.join(RAIZ, "apps", "web", "data", "ambiente");
const ARQUIVO_SAIDA = path.join(DIR_DATA, "ameacas-americas.compact.json");

