// EXECUTOR PRINCIPAL DO ETL
// ══════════════════════════════════════════════════════════════════════════
async function main() {
  console.log("🌱 [ETL Ambiente] Iniciando consolidação do acervo de Ameaças Ambientais nas Américas...");

  const todosRegistros: RegistroAmeacaAmericas[] = [
    ...ESPECIES_AMEACADAS,
    ...RIOS_AMEACADOS,
    ...SERRAS_AMEACADAS,
    ...COMUNIDADES_TRADICIONAIS,
  ];

  console.log(`📊 Total de registros coletados: ${todosRegistros.length}`);
  console.log(`   - Espécies Ameaçadas: ${ESPECIES_AMEACADAS.length}`);
  console.log(`   - Rios Ameaçados: ${RIOS_AMEACADOS.length}`);
  console.log(`   - Serras Ameaçadas: ${SERRAS_AMEACADAS.length}`);
  console.log(`   - Comunidades Tradicionais: ${COMUNIDADES_TRADICIONAIS.length}`);

  // Validação de chaves e campos obrigatórios
  const chavesReferencia = Object.keys(todosRegistros[0]);
  for (const [idx, item] of todosRegistros.entries()) {
    const chavesItem = Object.keys(item);
    if (chavesItem.length !== chavesReferencia.length) {
      throw new Error(`Item ${idx} (${item.id}) tem ${chavesItem.length} chaves, esperado ${chavesReferencia.length}`);
    }
    for (const k of chavesReferencia) {
      const val = (item as unknown as Record<string, unknown>)[k];
      if (val === undefined || val === null || val === "") {
        throw new Error(`Item ${idx} (${item.id}) tem campo vazio '${k}'`);
      }
    }
  }

  // Assegurar diretório de saída
  if (!fs.existsSync(DIR_DATA)) {
    fs.mkdirSync(DIR_DATA, { recursive: true });
    console.log(`📁 Criado diretório de saída: ${DIR_DATA}`);
  }

  // Compactação de alta densidade
  console.log("📦 Compactando com esqueleto + rótulos internados...");
  const tabelaCompacta = compactar(todosRegistros, {
    nuncaInternar: ["id", "urlFonte", "descricaoImpacto", "vetoresPressao"],
  });

  const cabecalho = {
    origem: "Controle Popular · Observatório Nacional Socioambiental (ONSA)",
    descricao: "Acervo de Ameaças Ambientais, Rios, Serras e Comunidades Tradicionais das Américas",
    data_geracao: new Date().toISOString(),
    total_registros: todosRegistros.length,
    contagem_por_categoria: {
      especie: ESPECIES_AMEACADAS.length,
      rio: RIOS_AMEACADOS.length,
      serra: SERRAS_AMEACADAS.length,
      comunidade: COMUNIDADES_TRADICIONAIS.length,
    },
    paises_cobertos: Array.from(new Set(todosRegistros.map((r) => r.pais))).sort(),
  };

  const conteudoCompacto = serializarCompacto(cabecalho, tabelaCompacta);
  fs.writeFileSync(ARQUIVO_SAIDA, conteudoCompacto, "utf-8");

  const stats = fs.statSync(ARQUIVO_SAIDA);
  console.log(`✅ Arquivo gerado com sucesso em: ${ARQUIVO_SAIDA}`);
  console.log(`   Tamanho final: ${(stats.size / 1024).toFixed(1)} KB`);
  console.log(`   Dicionários criados: ${Object.keys(tabelaCompacta.dicionarios).join(", ")}`);
}

main().catch((erro) => {
  console.error("❌ Falha fatal no ETL:", erro);
  process.exit(1);
});
