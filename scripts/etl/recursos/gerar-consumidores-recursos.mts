function sanitizarLista<T extends Record<string, unknown>>(lista: T[]): T[] {
  return lista.map((item) => {
    const limpo: Record<string, unknown> = {};
    for (const [k, v] of Object.entries(item)) {
      if (typeof v === "string") {
        limpo[k] = sanitizarDadoPessoalInternacional(v);
      } else {
        limpo[k] = v;
      }
    }
    return limpo as T;
  });
}

function main() {
  console.log("🚀 Iniciando geração dos datasets de Maiores Consumidores (MG + G20)...");

  if (!fs.existsSync(DIR_OUT)) {
    fs.mkdirSync(DIR_OUT, { recursive: true });
  }

  // 1. Top 50 MG Consumidores
  const mgLimpos = sanitizarLista(TOP_50_MG_CONSUMIDORES);
  const mgCompacto = compactar(mgLimpos);
  const arqMg = path.join(DIR_OUT, "top50-mg-consumidores.compact.json");
  fs.writeFileSync(arqMg, JSON.stringify(mgCompacto, null, 2), "utf-8");
  console.log(
    `✅ top50-mg-consumidores.compact.json gerado (${mgLimpos.length} registros, ${(fs.statSync(arqMg).size / 1024).toFixed(1)} KB).`
  );

  // 2. G20 Consumo Setorial e Corporativo
  const g20Limpos = sanitizarLista(G20_CONSUMO_CORPORATIVO);
  const g20Compacto = compactar(g20Limpos);
  const arqG20 = path.join(DIR_OUT, "g20-consumo-setorial-corporativo.compact.json");
  fs.writeFileSync(arqG20, JSON.stringify(g20Compacto, null, 2), "utf-8");
  console.log(
    `✅ g20-consumo-setorial-corporativo.compact.json gerado (${g20Limpos.length} países, ${(fs.statSync(arqG20).size / 1024).toFixed(1)} KB).`
  );

  // 3. Pegada Hídrica e Intensidade Setorial CNAE
  const pegadaLimpos = sanitizarLista(PEGADA_E_INTENSIDADE_SETORIAL);
  const pegadaCompacto = compactar(pegadaLimpos);
  const arqPegada = path.join(DIR_OUT, "pegada-hidrica-e-cnae.compact.json");
  fs.writeFileSync(arqPegada, JSON.stringify(pegadaCompacto, null, 2), "utf-8");
  console.log(
    `✅ pegada-hidrica-e-cnae.compact.json gerado (${pegadaLimpos.length} setores, ${(fs.statSync(arqPegada).size / 1024).toFixed(1)} KB).`
