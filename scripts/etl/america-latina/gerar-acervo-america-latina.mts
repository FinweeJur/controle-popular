/**
 * Converte as instalações para GeoJSON FeatureCollection.
 */
export function gerarGeoJsonInstalacoesLatam(): object {
  return {
    type: "FeatureCollection",
    metadata: {
      fonte: "Controle Popular — Observatório Transnacional de Mineração na América Latina",
      dataAtualizacao: "2026-09-30",
      totalInstalacoes: INSTALACOES_LATAM.length,
      paisesCobertos: ["Brasil", "Chile", "Peru", "Argentina", "México", "Colômbia", "Bolívia", "Equador", "Panamá"],
      aviso: "Coordenadas precisas em datum WGS84 compiladas a partir de relatórios regulatórios oficiais e imagens de satélite.",
    },
    features: INSTALACOES_LATAM.map((inst) => ({
      type: "Feature",
      id: inst.id,
      geometry: {
        type: "Point",
        coordinates: [inst.longitude, inst.latitude],
      },
      properties: {
        id: inst.id,
        nome: inst.nome,
        empresa: inst.empresa,
        pais: inst.pais,
        tipo: inst.tipo,
        mineral: inst.mineralPrincipal,
        status: inst.status,
        bacia: inst.baciaOuRegiao,
        fonte: inst.fonteOficial,
        descricao: inst.descricao,
      },
    })),
  };
}

/**
 * Executa a compilação e gravação dos arquivos.
 */
export function executarEtlAmericaLatina(): void {
  console.log("🌎 Iniciando ETL de Mineração e Instalações da América Latina...");

  // 1. Gera GeoJSON para o Globo 3D
  fs.mkdirSync(path.dirname(GEOJSON_DESTINO), { recursive: true });
  const geojson = gerarGeoJsonInstalacoesLatam();
  fs.writeFileSync(GEOJSON_DESTINO, JSON.stringify(geojson, null, 2), "utf-8");
  console.log(`✓ GeoJSON salvo em: ${GEOJSON_DESTINO} (${INSTALACOES_LATAM.length} feições)`);

  // 2. Compacta dados para o frontend Next.js
  fs.mkdirSync(DATA_DIR, { recursive: true });
  const compactadoInstalacoes = compactar(INSTALACOES_LATAM as unknown as Record<string, unknown>[]);
  const caminhoJsonCompacto = path.join(DATA_DIR, "instalacoes-latam.compact.json");
  fs.writeFileSync(caminhoJsonCompacto, JSON.stringify(compactadoInstalacoes), "utf-8");
  console.log(`✓ JSON compactado salvo em: ${caminhoJsonCompacto}`);

  // 3. Agrupamento por empresas corporativas da América Latina
  const empresasAgrupadas = Array.from(new Set(INSTALACOES_LATAM.map((i) => i.empresa))).map((empresa) => {
    const insts = INSTALACOES_LATAM.filter((i) => i.empresa === empresa);
    const paises = Array.from(new Set(insts.map((i) => i.pais)));
    const minerais = Array.from(new Set(insts.map((i) => i.mineralPrincipal)));
    return {
      empresa,
      totalInstalacoes: insts.length,
      paises,
      minerais,
      instalacoes: insts.map((i) => ({ id: i.id, nome: i.nome, tipo: i.tipo })),
    };
  });

  const compactadoEmpresas = compactar(empresasAgrupadas as unknown as Record<string, unknown>[]);
  const caminhoEmpresas = path.join(DATA_DIR, "mineradoras-latam.compact.json");
  fs.writeFileSync(caminhoEmpresas, JSON.stringify(compactadoEmpresas), "utf-8");
  console.log(`✓ Acervo de mineradoras compactado salvo em: ${caminhoEmpresas} (${empresasAgrupadas.length} empresas)`);
}

if (process.argv[1] && process.argv[1].endsWith("gerar-acervo-america-latina.mts")) {
  executarEtlAmericaLatina();
}
