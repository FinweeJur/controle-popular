// 4. EXECUÇÃO DO ETL E COMPACTAÇÃO VIA compactar.ts
// ══════════════════════════════════════════════════════════════════════════

export function executarEtlConglomerados(): void {
  console.log("🏢 Iniciando ETL de Conglomerados, Holdings, Monopólios e Cartéis...");

  fs.mkdirSync(DATA_DIR, { recursive: true });

  // 1. Compacta os nós corporativos e holdings
  const compactadoNos = compactar(NOS_CONGLOMERADOS as unknown as Record<string, unknown>[]);
  const caminhoNos = path.join(DATA_DIR, "conglomerados-holdings.compact.json");
  fs.writeFileSync(caminhoNos, JSON.stringify(compactadoNos), "utf-8");
  console.log(`✓ Holdings e Nós compactados salvos em: ${caminhoNos} (${NOS_CONGLOMERADOS.length} entidades)`);

  // 2. Compacta as arestas de controle societário
  const compactadoArestas = compactar(ARESTAS_CONTROLE as unknown as Record<string, unknown>[]);
  const caminhoArestas = path.join(DATA_DIR, "conglomerados-arestas.compact.json");
  fs.writeFileSync(caminhoArestas, JSON.stringify(compactadoArestas), "utf-8");
  console.log(`✓ Arestas de controle acionário salvas em: ${caminhoArestas} (${ARESTAS_CONTROLE.length} arestas)`);

  // 3. Compacta os indicadores setoriais HHI
  const compactadoSetores = compactar(CONCENTRACAO_SETORIAL as unknown as Record<string, unknown>[]);
  const caminhoSetores = path.join(DATA_DIR, "conglomerados-setores.compact.json");
  fs.writeFileSync(caminhoSetores, JSON.stringify(compactadoSetores), "utf-8");
  console.log(`✓ Análise de concentração setorial HHI salva em: ${caminhoSetores} (${CONCENTRACAO_SETORIAL.length} setores)`);

  console.log("🌟 ETL de Conglomerados concluído com sucesso!");
}

if (process.argv[1] && process.argv[1].endsWith("gerar-conglomerados-monopolios.mts")) {
  executarEtlConglomerados();
}
