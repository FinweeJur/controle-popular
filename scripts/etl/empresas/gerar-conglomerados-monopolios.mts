export type TipoNoConglomerado =
  | "holding"
  | "investimento"
  | "subsidiaria"
  | "concessao";

export type SetorConglomerado =
  | "mineracao"
  | "agronegocio_graos"
  | "energia_petroleo"
  | "bancos_financas"
  | "tecnologia";

