export function gerarAcervoEuropa(): void {
  // Garantir diretórios
  if (!fs.existsSync(DIR_DATA_INTERNACIONAL)) {
    fs.mkdirSync(DIR_DATA_INTERNACIONAL, { recursive: true });
  }
  if (!fs.existsSync(DIR_DATA_EUROPA)) {
    fs.mkdirSync(DIR_DATA_EUROPA, { recursive: true });
  }

  // Compactar dados usando o algoritmo do repositório (compactar.ts)
  const compactado = compactar(
    ACERVO_EUROPA_TRANSNACIONAL as unknown as Record<string, unknown>[]
  );

  const conteudoJson = JSON.stringify(compactado, null, 2);

  const caminhoInternacional = path.join(
    DIR_DATA_INTERNACIONAL,
    "europa-transnacional.compact.json"
  );
  const caminhoEuropa = path.join(
    DIR_DATA_EUROPA,
    "europa-transnacional.compact.json"
  );

  fs.writeFileSync(caminhoInternacional, conteudoJson, "utf8");
  fs.writeFileSync(caminhoEuropa, conteudoJson, "utf8");

  console.log(`✅ Acervo Europa gerado com sucesso!`);
  console.log(`- Registros: ${ACERVO_EUROPA_TRANSNACIONAL.length}`);
  console.log(`- Arquivo 1: ${caminhoInternacional} (${Buffer.byteLength(conteudoJson, "utf8")} bytes)`);
  console.log(`- Arquivo 2: ${caminhoEuropa} (${Buffer.byteLength(conteudoJson, "utf8")} bytes)`);
}

// Executar se chamado diretamente
if (process.argv[1] && process.argv[1].endsWith("gerar-europa-acervo.mts")) {
  gerarAcervoEuropa();
}
