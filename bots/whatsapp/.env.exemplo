# Variáveis de ambiente para o bot WhatsApp (bots/whatsapp).
# Copie para scripts/.env e preencha. O .gitignore do repo já cobre scripts/.env.

# JID(s) do(s) grupo(s) do WhatsApp — use --list-groups depois do pairing para achar.
# Exemplo: 553199999999-1234567890@g.us
WHATSAPP_GROUP_JID=

# Números (país+DDD sem formatação) autorizados a comandar o bot.
# Exemplo: 553175709609,553171404503
WHATSAPP_ALLOWED_NUMBERS=

# Número do bot (seu WhatsApp) — usado para detectar menções em grupos.
# Exemplo: 553182377181
WHATSAPP_BOT_NUMBER=

# Caminho do SQLite store (onde a sessão do WhatsApp é salva).
# Default: bots/whatsapp/store.db
WHATSAPP_STORE_PATH=
