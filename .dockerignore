# .dockerignore — Controle Popular
# Regras estritas para blindagem do contexto de build do Docker no Guara Cloud
# Objetivo: Garantir contexto < 150 MB e evitar o estouro de 12Gi do BuildKit.

# 1. Dependências e builds intermediários (todos os níveis)
node_modules
**/node_modules
.next
**/.next
.open-next
**/.open-next
out
**/out
**/out/**
dist
**/dist
**/dist/**
.wrangler
**/.wrangler*
.arquivo-local
**/.arquivo-local*
.cache
**/.cache
**/.cache/**
scripts/.cache/**

# 2. Arquivos compactados e temporários
_tmp*
**/_tmp*
**/*.zip
**/*.tar
**/*.tar.gz
**/*.tgz
**/*.rar
**/*.7z
# Exceção permitida: camadas geojson comprimidas usadas no Globo 3D
!apps/web/public/terras/globo/dados/camadas/*.geojson.gz

# 3. Logs, dumps e backups
*.log
**/*.log
*.sql
**/*.sql
*.docx
**/*.docx
*.pyc
**/*.pyc
__pycache__
**/__pycache__
d1-backup*
build-status.txt
.env*.local

# 4. Controle de versão e ferramentas de desenvolvimento/IA
.git
.claude
.opencode
.cursor
.vscode
.agents
.hermes
.github
.githooks
skills
handoffs
models
neon_export

# 5. Documentação, design e relatórios (não utilizados no runtime/build)
docs/**
companion/**
supabase/**
bots/**
colibri/**
screenshots/**
logs/**
acervo-documentos/**
documentos-site/**
data/**
commit_msg_*.txt
pr_body_*.md
test_*.png
test_*.js
bots_*.js
*.test_result.json

# 6. Pipeline ETL fora do build
# ATENÇÃO: Apenas etl/betim/dados/ é lido pelo app (json-etl.ts). O restante é ignorado.
etl/**
!etl/betim/dados/**

# 7. Acervos pesados de empresas e PDFs brutos fora do bundle
apps/web/data/esg/**
apps/web/data/documentos-empresas/**
**/*.pdf
!apps/web/public/**/*.pdf

# 8. JSONs de licenciamento bruto com amostras versionadas
# O build lê a AMOSTRA em apps/web/data/amostras/
apps/web/data/ana-outorgas.json
apps/web/data/cetesb-sp-licencas.json
apps/web/data/fepam-rs-licencas.json
apps/web/data/ibama-autos-infracao.json
apps/web/data/ibama-licencas.json
apps/web/data/ibram-df-licencas.json
apps/web/data/iema-es-licencas.json
apps/web/data/igam-outorgas.json
apps/web/data/ima-sc-licencas.json
apps/web/data/imasul-ms-licencas.json
apps/web/data/inema-ba-licencas.json
apps/web/data/iat-pr-licencas.json
apps/web/data/sema-ma-licencas.json
apps/web/data/sema-mt-licencas.json
apps/web/data/semas-pa-licencas.json
apps/web/data/semad-go-licencas.json
apps/web/data/semar-pi-licencas.json
apps/web/data/sedam-ro-licencas.json
