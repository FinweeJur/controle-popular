# Copie para .env e preencha. Este ETL fala com o MESMO Postgres que
# apps/web/.env.local — normalmente o mesmo valor de DATABASE_URL nos dois.
# As fontes deste eixo (portais dos tribunais e do CNJ) não
# exigem chave — só isto é necessário para rodar.

DATABASE_URL=postgresql://usuario:senha@host/banco?sslmode=require
