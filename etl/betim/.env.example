# Copie para .env e preencha. Este ETL fala com o MESMO Postgres que
# apps/web/.env.local — normalmente o mesmo valor de DATABASE_URL nos dois.

DATABASE_URL=postgresql://usuario:senha@host/banco?sslmode=require

# Portal da Transparência (api.portaldatransparencia.gov.br) — cadastro
# gratuito em https://api.portaldatransparencia.gov.br/swagger-ui.html.
# Usado por etl/apis/transparencia_gov.py e etl/apis/beneficios_sociais.py.
TRANSPARENCIA_API_KEY=

# dados.gov.br — cadastro gratuito no próprio portal.
DADOS_GOV_BR_API_TOKEN=

# BigQuery da Base dos Dados (base-dos-dados), usado pelo módulo etl/bd/ —
# caminho para o JSON da service account do SEU projeto GCP (não é
# necessário para os módulos que não tocam etl/bd/).
GOOGLE_APPLICATION_CREDENTIALS=
BASEDOSDADOS_BILLING_PROJECT_ID=
GCP_PROJECT_ID=

# Token das rotas /api/admin/* do app Next — mesmo valor de
# apps/web (.env.local ou secret do Worker). Só necessário para os módulos
# de ETL que chamam essas rotas de volta.
ADMIN_TOKEN=
